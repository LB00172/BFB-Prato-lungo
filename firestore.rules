// ============================================================================
//  REGOLE FIRESTORE — Camp Ops (versione pubblica)
// ============================================================================
// Da incollare in: console.firebase.google.com -> progetto **camp-ops**
// -> Firestore Database -> scheda "Regole" -> sostituisci tutto -> Pubblica.
//
// ⚠️ NON e' il progetto della Brigata. Dal 22 settembre i progetti sono due:
// `camp-ops` per la versione pubblica, `brigata-bandone` per quella privata.
// Queste regole parlano SOLO di stanze: qui dentro `camps/` non esiste, e
// l'utente condiviso del campo 2026 nemmeno. Se stai guardando queste regole
// chiedendoti dove sia finito il ponte verso `camps/`, la risposta e' che non
// serve piu' un ponte fra due progetti diversi — si e' portato via anche le
// cinque verifiche che lo sorvegliavano.
//
// **Queste regole si provano prima di pubblicarle**: `npm run regole` le
// carica in un emulatore Firestore locale e prova a violarle una per una.
// Una regola di sicurezza scritta e mai vista negare qualcosa non e' una
// regola: e' una speranza (CLAUDE.md, regola 5).
//
// ----------------------------------------------------------------------------
// Come si entra in una stanza, senza backend: l'impronta del codice
// d'ingresso sta in rooms/<id>/private/join, che **nessun client puo'
// leggere**. Le get() delle regole pero' girano sul server e non passano dai
// permessi del client: la regola che autorizza a scriversi in members/<uid>
// confronta l'impronta portata dal telefono con quella custodita li'.
// Niente Cloud Function, niente piano Blaze.
//
// L'impronta finisce dentro members/<uid> e ci resta. Non e' una perdita:
// members lo leggono solo i membri, e un membro il codice lo conosce gia' —
// l'ha digitato per entrare. Quando si toglie qualcuno dalla stanza, pero',
// il codice va cambiato: lui se lo ricorda.
// ----------------------------------------------------------------------------

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Chi sei ----------

    function scheda(stanza) {
      return /databases/$(database)/documents/rooms/$(stanza)/members/$(request.auth.uid);
    }

    function membro(stanza) {
      return request.auth != null && exists(scheda(stanza));
    }

    // Il ruolo si legge dalla scheda. Va chiamata solo dopo membro(): su una
    // scheda che non esiste, get() fa fallire la valutazione — e una regola
    // che fallisce nega, quindi il risultato e' giusto lo stesso, ma il
    // messaggio d'errore diventa incomprensibile.
    function ruolo(stanza) {
      return get(scheda(stanza)).data.ruolo;
    }

    // Chi amministra lo dice il DOCUMENTO DELLA STANZA, non la scheda del
    // membro. Dal 28 settembre il campo puo' passare di mano (all'aiutante):
    // chi lo cede ha ancora per un attimo una scheda con scritto
    // «proprietario», finche' non se ne va — e se non riuscisse ad andarsene
    // (senza linea), quella scheda non deve valere niente.
    function stanzaDoc(stanza) {
      return get(/databases/$(database)/documents/rooms/$(stanza)).data;
    }

    // Chi amministra: il capogruppo — il proprietario — e, dal 30 settembre,
    // il SECONDO capogruppo che lui ha nominato (vice): il capo sul posto
    // accanto a chi organizza. Lo dicono tutti e due i nomi scritti nella
    // stanza, non le schede dei membri.
    function amministra(stanza) {
      let s = stanzaDoc(stanza);
      return membro(stanza)
        && (s.proprietario == request.auth.uid || s.get('vice', '') == request.auth.uid);
    }

    // Il PRIMO capogruppo: chi ha creato il campo (o l'ha ricevuto). Tre cose
    // restano solo sue: scegliere il secondo, passare il campo, cancellarlo.
    function primoCapo(stanza) {
      return membro(stanza) && stanzaDoc(stanza).proprietario == request.auth.uid;
    }

    // Il Pro del campo, acceso e non scaduto. `scade` e' un timestamp che
    // scrive il server insieme a `fino` (la data 'AAAA-MM-GG' che legge
    // l'app): le regole con una data scritta come testo non sanno fare
    // confronti, con un timestamp si'. Senza `scade` il Pro non scade.
    function proAttivo(stanza) {
      let p = stanzaDoc(stanza).get('pro', null);
      return p != null && p.get('attivo', false) == true
        && (!('scade' in p) || request.time < p.scade);
    }

    function membroDi(stanza, uid) {
      return exists(/databases/$(database)/documents/rooms/$(stanza)/members/$(uid));
    }

    function modifica(stanza) {
      return membro(stanza) && ruolo(stanza) in ['proprietario', 'redattore'];
    }

    // ---------- Le stanze ----------
    match /rooms/{stanza} {
      allow get, list: if membro(stanza);

      // Creare una stanza vuol dire diventarne il proprietario, e un campo
      // senza un padrone raggiungibile non si amministra: serve un indirizzo
      // verificato. E' la stessa riga della tabella dei permessi di auth.js
      // ('creare' vuole REGISTRATO), scritta dove conta davvero.
      //
      // Il Pro. E' del CAMPO, non della persona: lo accende il server che
      // verifica l'acquisto fatto da chi ha creato il campo, con la chiave di
      // servizio — che queste regole non le guarda. Da un telefono non lo
      // scrive nessuno, proprietario compreso: se potesse lui, se lo
      // regalerebbe chiunque crei un campo. E chi entra non porta niente con
      // se': chi e' Pro in un altro gruppo qui non ha nessun campo da toccare.
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.proprietario == request.auth.uid
        && !('pro' in request.resource.data);

      // Due strade, e basta.
      allow update: if amministra(stanza) && (
        // 1. Il capogruppo cambia il suo campo: nome, date, regole, e chi e'
        //    l'aiutante — un membro, e non se stesso. Il capogruppo non si
        //    riscrive, e il Pro non si accende, non si allunga e non si
        //    toglie.
        (request.resource.data.proprietario == resource.data.proprietario
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pro'])
          // Il secondo capogruppo amministra, ma non sceglie chi e' il
          // secondo: ne' un altro al posto suo, ne' nessuno.
          && (resource.data.proprietario == request.auth.uid
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['vice']))
          // Il vice nuovo, QUANDO cambia: un membro, e non se stessi. Si
          // guarda solo se cambia, perche' il documento dopo la scrittura lo
          // contiene sempre: per il secondo capogruppo e' il suo stesso uid, e
          // guardarlo sempre gli negherebbe ogni scrittura.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['vice'])
              || !('vice' in request.resource.data)
              || (request.resource.data.vice != request.auth.uid
                  && membroDi(stanza, request.resource.data.vice))))
        ||
        // 2. Il capogruppo lascia il campo all'AIUTANTE che aveva nominato,
        //    e a nessun altro. Il Pro l'ha pagato chi se ne va e non passa
        //    di mano: il passaggio lo deve spegnere nello stesso gesto. E'
        //    l'unica scrittura con cui un telefono tocca il Pro — per
        //    toglierlo, mai per darlo.
        // Solo il PRIMO: altrimenti il secondo userebbe questa strada per
        // prendersi il campo di chi l'ha creato.
        (resource.data.proprietario == request.auth.uid
          && 'vice' in resource.data
          && request.resource.data.proprietario == resource.data.vice
          && membroDi(stanza, resource.data.vice)
          && !('pro' in request.resource.data)
          && !('vice' in request.resource.data))
      );

      allow delete: if primoCapo(stanza);

      // Il segreto. Non lo legge NESSUNO — nemmeno il proprietario, che
      // l'impronta non ha motivo di rileggerla: il codice ce l'ha lui.
      // Le get() delle regole ci arrivano lo stesso: girano sul server.
      match /private/{doc} {
        allow read: if false;
        // Si scrive solo insieme alla stanza (il proprietario la sta creando)
        // o dopo, per cambiare il codice.
        allow write: if request.auth != null
          && (amministra(stanza)
              || get(/databases/$(database)/documents/rooms/$(stanza)).data.proprietario == request.auth.uid);
      }

      // ---------- Chi c'e' dentro ----------
      match /members/{uid} {
        allow read: if membro(stanza);

        // Ci si scrive TU, col tuo uid, e in due modi soli.
        //
        // 1. ENTRANDO col codice: si entra da redattori e si porta
        //    l'impronta. Il ruolo non te lo scegli — altrimenti il primo che
        //    entra si scrive proprietario e amministra il campo di un altro.
        //
        // 2. CREANDO la stanza: chi l'ha appena creata e' il proprietario, e
        //    l'impronta non la porta perche' il segreto l'ha scritto lui un
        //    attimo fa. Senza questa meta', creare una stanza voleva dire
        //    restare chiusi fuori: il documento nasceva, la scheda del
        //    proprietario veniva negata, e da li' in poi nemmeno leggere la
        //    propria stanza era permesso. A dire chi e' il proprietario e' il
        //    documento della stanza, che nessuno puo' riscrivere (la update
        //    qui sopra congela quel campo): non e' una porta di servizio, e'
        //    la stessa serratura letta dall'altro lato.
        allow create: if request.auth != null
          && uid == request.auth.uid
          && (
            (request.resource.data.ruolo == 'redattore'
             && request.resource.data.prova ==
                get(/databases/$(database)/documents/rooms/$(stanza)/private/join).data.impronta)
            ||
            (request.resource.data.ruolo == 'proprietario'
             && get(/databases/$(database)/documents/rooms/$(stanza)).data.proprietario == request.auth.uid)
          );

        // Il proprietario cambia i ruoli. Ma non il proprio: togliersi il
        // ruolo da soli lascerebbe una stanza che non amministra piu'
        // nessuno e che non si puo' nemmeno cancellare.
        // La scheda del primo capogruppo non la riscrive nessun altro,
        // nemmeno il secondo.
        allow update: if amministra(stanza) && uid != request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(stanza)).data.proprietario != uid;
        // (ruolo() resta per modifica(): chi scrive i dati lo dice la scheda.)

        // Si esce da soli, o ti toglie il proprietario. Il proprietario no:
        // stesso vicolo cieco di sopra.
        allow delete: if (uid == request.auth.uid || amministra(stanza))
          && get(/databases/$(database)/documents/rooms/$(stanza)).data.proprietario != uid;
      }

      // ---------- I dati del campo ----------
      // Presenze, spese, menu', scontrini, foto: tutto quello che un campo
      // mette insieme. Il lettore guarda, il redattore scrive.
      //
      // Si legge tutto, a qualunque profondita'. Si scrive per forma, perche'
      // le forme sono due e basta (firebase-sync.js, percorso()): lo stato
      // del campo, `dati/stato`, e i documenti delle sue raccolte,
      // `dati/stato/<raccolta>/<id>`. Una forma diversa non si scrive: non
      // la usa nessuno, e una strada non prevista non nasce aperta.
      match /dati/{resto=**} {
        allow read: if membro(stanza);
      }
      match /dati/{documento} {
        allow write: if modifica(stanza);
      }
      // Le foto degli scontrini nel cloud sono del Pro (Stanza.FUNZIONI_PRO,
      // 'fotoCloud'): sono quello che costa davvero. Metterne una nuova o
      // riscriverla vuole il campo Pro; toglierla no — togliere una spesa
      // toglie anche il suo scontrino, e un campo non ha pagato per non poter
      // fare ordine. Tutte le altre raccolte si scrivono come prima.
      match /dati/{documento}/{raccolta}/{id} {
        allow create, update: if modifica(stanza) && (raccolta != 'receipts' || proAttivo(stanza));
        allow delete: if modifica(stanza);
      }
    }

    // ---------- Il profilo: tuo, e di nessun altro ----------
    // nome, cognome, indirizzo. Lo legge e lo scrive SOLO il proprietario:
    // niente lettura fra utenti, nemmeno fra membri della stessa stanza.
    //
    // Sembra scomodo e invece non manca niente: il nome che si vede accanto
    // ai saldi sta in rooms/<id>/members/<uid>, scritto entrando. Aprire
    // users/ ai compagni di stanza vorrebbe dire regalare l'indirizzo email
    // di tutti a chiunque conosca un codice d'ingresso — e un indirizzo
    // email, una volta uscito, non si fa rientrare.
    //
    // L'anonimo qui non arriva mai: non gli si scrive un profilo (la regola
    // sta in auth.js, profiloDaSalvare). Ma se ci arrivasse, la riga qui
    // sotto lo lascerebbe fare, e va bene: sarebbe roba sua, sotto il suo
    // uid, illeggibile da chiunque altro.
    match /users/{uid} {
      allow read, write: if request.auth != null && uid == request.auth.uid;
    }

    // ---------- L'abbonamento annuale ----------
    // Lo scrive solo il server che verifica il pagamento (functions/): da un
    // telefono nessuno, nemmeno il proprio. Ma ognuno legge il PROPRIO — la
    // Panoramica dei campi si apre con l'abbonamento annuale, e l'app deve
    // sapere se c'e'. Quello degli altri no: dice chi paga.
    match /abbonati/{uid} {
      allow read: if request.auth != null && uid == request.auth.uid;
      allow write: if false;
    }

    // ---------- Tutto il resto e' chiuso ----------
    // Va per ultimo e nega: una collezione nuova non nasce aperta per
    // distrazione. Se domani serve, si scrive la sua regola qui sopra.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
